{
  "family": "novamind-auth",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::637423369471:role/novamindECSTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::637423369471:role/novamindAuthTaskRole",
  "containerDefinitions": [
    {
      "name": "auth",
      "image": "637423369471.dkr.ecr.us-east-1.amazonaws.com/auth-service:latest",
      "portMappings": [
        { "containerPort": 8001, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT",                "value": "8001" },
        { "name": "NODE_ENV",            "value": "production" },
        { "name": "ADMIN_EMAIL",         "value": "aamirimran49000@gmail.com" },
        { "name": "REDIS_URL",           "value": "redis://novamind-redis.7tlv0b.0001.use1.cache.amazonaws.com:6379" },
        { "name": "BILLING_MONGODB_URI", "value": "mongodb+srv://aamirimran49000_db_user:rRhwz8ZhbNgPfBXd@cluster0.ig23zmc.mongodb.net/?appName=Cluster0/billing" },
        { "name": "CHAT_MONGODB_URI",    "value": "mongodb+srv://aamirimran49000_db_user:rRhwz8ZhbNgPfBXd@cluster0.ig23zmc.mongodb.net/?appName=Cluster0/chat" }
      ],
      "secrets": [
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423369471:secret:novamind/auth/mongodb-uri-ptOVdx"
        },
        {
          "name": "FIREBASE_SERVICE_ACCOUNT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423369471:secret:novamind/auth/firebase-service-account-gDaKfv"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/novamind-auth",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "auth"
        }
      },
      "essential": true
    }
  ]
}
